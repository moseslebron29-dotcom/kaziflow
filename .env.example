# KaziFlow environment variables — placeholder names only.
# Copy to .env for local development. NEVER commit a real .env file.
# On Render, set these under Service → Environment.

# ---------------------------------------------------------------- Core
NODE_ENV=production
PORT=3000
# Public HTTPS address of the site (used in email links and M-Pesa callbacks).
KAZIFLOW_PUBLIC_ORIGIN=https://your-kaziflow-domain.example
# At least 32 random characters. Signs login sessions and OTP hashes.
KAZIFLOW_SESSION_SECRET=replace-with-64-random-characters
# Set to false ONLY for plain-http local development.
# KAZIFLOW_COOKIE_SECURE=false

# ---------------------------------------------------------------- Database (PostgreSQL)
# Render: use the Internal Database URL of your Render PostgreSQL instance.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# true when connecting over the public internet (External Database URL).
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------- Administrator
# Primary super-administrator email. Its password is chosen on /admin/setup.
ADMIN_EMAIL=moseslebron29@gmail.com
# One-time setup token (32+ random characters). Remove after the admin is created.
KAZIFLOW_ADMIN_BOOTSTRAP_TOKEN=replace-with-a-random-one-time-token

# ---------------------------------------------------------------- Brevo email
KAZIFLOW_BREVO_API_KEY=replace-with-brevo-api-key
# Must be a sender verified in Brevo.
KAZIFLOW_EMAIL_FROM=KaziFlow <no-reply@your-kaziflow-domain.example>

# ---------------------------------------------------------------- Safaricom Daraja — STK Push (activation & campaign funding)
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=replace-with-consumer-key
DARAJA_CONSUMER_SECRET=replace-with-consumer-secret
DARAJA_SHORTCODE=replace-with-shortcode
DARAJA_PASSKEY=replace-with-passkey
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till)
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# Till number when it differs from the shortcode (Buy Goods only). Optional.
DARAJA_PARTY_B=
DARAJA_CALLBACK_URL=https://your-kaziflow-domain.example/api/daraja/callback
# Random secret appended to callback URLs (required in production).
DARAJA_CALLBACK_TOKEN=replace-with-32-random-characters
# Must be "true" before DARAJA_ENVIRONMENT=production will take real payments.
KAZIFLOW_LIVE_PAYMENTS_ENABLED=false

# ---------------------------------------------------------------- Safaricom Daraja — B2C (withdrawals)
DARAJA_B2C_SHORTCODE=replace-with-b2c-shortcode
DARAJA_B2C_INITIATOR_NAME=replace-with-initiator-name
DARAJA_B2C_SECURITY_CREDENTIAL=replace-with-encrypted-initiator-credential
# Optional when the B2C app uses different keys from STK Push.
DARAJA_B2C_CONSUMER_KEY=
DARAJA_B2C_CONSUMER_SECRET=
DARAJA_B2C_COMMAND_ID=BusinessPayment

# ---------------------------------------------------------------- File uploads
# Recommended: S3-compatible storage (Cloudflare R2, AWS S3, Backblaze B2).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Optional: local disk. Only set this if you attach a Render persistent disk.
# With no S3 bucket and no UPLOAD_DIR, uploads are saved in the Postgres database,
# so they survive restarts on the free plan.
UPLOAD_DIR=

# ---------------------------------------------------------------- Google AdSense (optional, after Google approval)
ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_POLICY=
