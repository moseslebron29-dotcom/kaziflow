# Platform injects DATABASE_URL and storage/service credentials in the managed project.
# Never paste real values into this template or commit a populated .env file.

# Exact owner-specified primary super-administrator account.
ADMIN_EMAIL=moseslebron29@gmail.com
# Generate privately: at least 32 random characters; one-time setup only.
KAZIFLOW_ADMIN_BOOTSTRAP_TOKEN=replace-with-a-random-one-time-token
# Optional 32+ character dedicated app-session key. Managed runtime can derive a
# project-scoped key from the platform secret when this is absent.
KAZIFLOW_SESSION_SECRET=

# Safaricom Daraja — use sandbox while testing.
DARAJA_CONSUMER_KEY=replace-with-sandbox-consumer-key
DARAJA_CONSUMER_SECRET=replace-with-sandbox-consumer-secret
DARAJA_SHORTCODE=replace-with-test-shortcode
DARAJA_PASSKEY=replace-with-sandbox-passkey
DARAJA_ENVIRONMENT=sandbox
DARAJA_CALLBACK_URL=https://your-public-https-host.example/api/daraja/callback
# Production payment starts are disabled unless this is deliberately enabled
# after separate go-live approval.
KAZIFLOW_LIVE_PAYMENTS_ENABLED=false

# Email verification/reset delivery through Brevo.
KAZIFLOW_BREVO_API_KEY=replace-with-brevo-transactional-key
KAZIFLOW_EMAIL_FROM=KaziFlow <no-reply@your-domain.example>
KAZIFLOW_PUBLIC_ORIGIN=https://your-public-https-host.example

# Local-only examples. Managed Preview uses HTTPS and should leave this unset.
PORT=3000
# KAZIFLOW_COOKIE_SECURE=false
